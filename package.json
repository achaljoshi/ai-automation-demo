{
  "name": "ai-automation-repo",
  "version": "1.0.0",
  "description": "AI-generated Playwright + playwright-bdd automation tests",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "test:regression": "bddgen && playwright test --grep @regression",
    "test:headed": "bddgen && playwright test --headed",
    "lint": "bddgen && tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.5",
    "playwright-bdd": "^9.2.1",
    "typescript": "^5.4.5"
  }
}
